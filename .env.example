# Copy to `.env` and fill in only what you need.
#
# EVERY value below is optional for the offline path. With an empty file, all of these
# still work:
#   python -m pytest tests -q
#   python backend/scripts/run_pack_b.py --llm off
#   python backend/scripts/run_pack_b.py --llm replay
#   python backend/scripts/run_pack_a.py --asr cached --llm replay
# The scripts call load_dotenv(ROOT/".env") themselves, so no shell exporting is needed.
#
# Never commit the filled file. Secrets enter a container only as host environment
# variables (.env is dockerignored and gitignored).

# ---- which rung of the fallback ladder is running --------------------------
# offline-ci | cached-demo | live-demo | safe-demo   (code default: cached-demo)
# Only `live-demo` lets the HTTP server make a network call for text.
RUN_MODE=
# live | cached  (code default: live; consulted only when RUN_MODE=live-demo,
# otherwise the server always uses CachedASR with the fixture transcript)
ASR=

# ---- text backend ----------------------------------------------------------
# openrouter | gemini
# backend/app/server.py and run_pack_a.py default to openrouter; kernel/factory.py
# defaults to gemini, so set it explicitly rather than relying on a default.
LLM_BACKEND=
# Required for RUN_MODE=live-demo with LLM_BACKEND=openrouter. Leave empty here.
OPENROUTER_API_KEY=
# Primary model string sent to OpenRouter. Code default matches the most reliable free route
# (nvidia/nemotron-3.5-super-vl:free). `stealth/crouton-alpha` was the original default and is
# NOT usable: it returns an empty completion with completion_tokens=0 on every call.
OPENROUTER_MODEL=
# Comma-separated fallback chain tried in order when a model errors, times out or returns an
# empty completion. Code default: empty (the primary model only).
OPENROUTER_MODEL_CHAIN=
# How long a model that just proved dead (empty completion / 404 / 429 / timeout) is skipped
# before it is retried. Without this a dead route is paid for on every turn of an episode.
# Code default: 600
OPENROUTER_DEAD_COOLDOWN_S=
# Override only for a proxy or a self-hosted compatible endpoint.
# Code default: https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
# Required only for the direct Gemini text backend. Leave empty here.
GEMINI_API_KEY=
# Comma-separated fallback chain, tried in order before a call fails.
# Code default: gemini-3.5-flash, gemini-3-flash-preview, gemini-3.1-flash-lite
GEMINI_MODEL_CHAIN=

# ---- record / replay -------------------------------------------------------
# For a deployment that a reviewer opens, `RUN_MODE=cached-demo` + `LLM_CASSETTE=replay` is the
# right pair: every card still commits, from 463 recorded model turns, with no quota spent.
# Switch to `RUN_MODE=live-demo` to call the real providers.
# record | replay | off   (code default: replay)
# `record` writes every model turn that parses into the cassette store; `replay` reads
# it back and never calls out; the drivers' --llm flag overrides this for a run.
LLM_CASSETTE=
# Directory holding the content-addressed cassettes.
# Code default: <repo>/tests/cassettes  -- those files are committed on purpose.
LLM_CASSETTE_DIR=

# ---- HTTP server behaviour -------------------------------------------------
# Seconds a blocking ask_user waits for a real fan before the episode resolves.
# Code default: 60
ASK_TIMEOUT_S=
# Concurrent web sessions kept before the store starts evicting. Code default: 12
MAX_SESSIONS=
# Set to 0 to close an SSE stream at `done` instead of keeping it open for late
# followers. Code default: 1
SSE_FOLLOW_AFTER_DONE=
# Docker only: the container binds 0.0.0.0:${PORT:-7860}. Locally uvicorn takes
# --port on the command line.
PORT=
